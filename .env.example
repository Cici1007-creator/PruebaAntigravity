# Puerto del servidor backend
PORT=3000

# Entorno de ejecución: development | production
NODE_ENV=development

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGIN=https://dropivault.netlify.app,http://localhost:5500

# Clave secreta para firmar sesiones y cookies en el servidor
SESSION_SECRET=

# Secreto para autenticación de Webhooks de Dropi (header x-dropi-secret o ?secret=)
DROPI_WEBHOOK_SECRET=

# Token de verificación para suscripción de Webhook de WhatsApp (Meta Cloud API)
WEBHOOK_SECRET=

# Secreto de la aplicación Meta para validar firma HMAC SHA256 (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=

# Credenciales de WhatsApp Cloud API (Meta for Developers)
# Dejar vacías para operar en modo simulación
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Credenciales para envío del Resumen Diario a Telegram Bot (Opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
