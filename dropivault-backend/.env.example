# Puerto del servidor
PORT=3000

# Orígenes permitidos para CORS (separados por coma si son varios)
ALLOWED_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# Clave secreta para firmar sesiones y tokens en el servidor
SESSION_SECRET=pon_aqui_una_clave_secreta_larga_y_aleatoria

# Identificador de Marca Blanca para la API de Dropi
DROPI_WHITE_BRAND_ID=df3e6b0bb66ceaadca4f84cbc371fd66e04d20fe51fc414da8d1b84d31d178de

# Credenciales de WhatsApp Cloud API (Meta for Developers)
# Dejar vacías para operar en modo simulación automática
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Token de verificación para Webhook de WhatsApp (Meta)
WEBHOOK_SECRET=dropivault_webhook_token_2026

# Credenciales para envío del Resumen Diario a Telegram Bot (Opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Entorno de ejecución: development | production
NODE_ENV=development
